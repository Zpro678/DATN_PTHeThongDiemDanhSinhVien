# =============================================================================
#  .env MẪU CHO MÔI TRƯỜNG LOCAL (máy dev)
#
#  Cách dùng:
#     cp .env.local.example .env
#     php artisan key:generate
#     docker compose -f docker-compose.local.yml up -d
#
#  Hạ tầng (MySQL/Redis/Mailpit) chạy trong Docker nhưng ĐƯỢC MỞ CỔNG ra host,
#  nên mọi HOST đều là 127.0.0.1 (PHP chạy ngoài Docker).
# =============================================================================

APP_NAME="Quan Ly Diem Danh Sinh Vien"
APP_ENV=local
# Để trống rồi chạy: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Local để debug: ghi mọi mức. Production dùng warning.
LOG_LEVEL=debug

# --- Cơ sở dữ liệu (container mysql của docker-compose.local.yml) -------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_quan_ly_diem_danh_v2
DB_USERNAME=root
DB_PASSWORD=root
# Dùng bởi docker-compose.local.yml để khởi tạo MySQL
MYSQL_ROOT_PASSWORD=root

# --- Redis: BẮT BUỘC (cache + session + queue + realtime) --------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=redis

FILESYSTEM_DISK=local

# --- Realtime (server.cjs) ---------------------------------------------------
SOCKET_PORT=3000
# Local: web chạy cổng 8000, socket chạy cổng 3000 -> client PHẢI trỏ thẳng
# sang 3000 (php artisan serve không proxy được). Production để TRỐNG.
# Đổi giá trị này phải chạy lại `npm run dev` / `npm run build`.
VITE_SOCKET_URL=http://127.0.0.1:3000

# --- Email: bắt hết vào Mailpit, KHÔNG gửi ra ngoài thật --------------------
#  Xem mail đã gửi tại http://localhost:8025
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# --- Chống gian lận GPS ------------------------------------------------------
# Local chạy trực tiếp, không qua proxy -> để trống.
TRUSTED_PROXIES=
# Để trống = tự TẮT khi chưa có TRUSTED_PROXIES (tránh báo nhầm khi dev).
GPS_IP_CHECK=

# --- Đăng nhập Google (tuỳ chọn) --------------------------------------------
# Tạo tại console.cloud.google.com -> Credentials -> OAuth client ID (Web).
# Authorized redirect URI phải khớp CHÍNH XÁC dòng dưới.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# --- Thanh toán (tuỳ chọn khi dev) ------------------------------------------
# Webhook cần URL public -> chạy `ngrok http 8000` rồi thay <ngrok-domain>.
# Điền credentials SANDBOX của riêng bạn, KHÔNG dùng lại key của người khác.

# MoMo Sandbox: lấy tại developers.momo.vn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_IPN_URL=https://<ngrok-domain>.ngrok-free.app/payment/momo/ipn

# PayOS: lấy tại my.payos.vn
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://127.0.0.1:8000/payment/payos/return
PAYOS_CANCEL_URL=http://127.0.0.1:8000/payment/payos/return?cancel=true

# --- Telegram (tuỳ chọn) -----------------------------------------------------
# Bot Token KHÔNG đặt ở đây mà nhập trong giao diện /admin/{id}/settings.
# Webhook cần URL public (ngrok), sau đó chạy: php artisan telegram:set-webhook
TELEGRAM_WEBHOOK_URL=
