# =============================================================================
#  .env MẪU CHO MÔI TRƯỜNG PRODUCTION (VPS, chạy full Docker)
#
#  Cách dùng:
#     cp .env.production.example .env
#     nano .env                      # điền domain, mật khẩu, credentials thật
#     docker compose up -d --build   # dùng docker-compose.yml
#     docker compose exec app php artisan key:generate --force
#
#  ⚠️ MỌI HOST là TÊN SERVICE trong docker network (mysql, redis), KHÔNG phải
#     127.0.0.1 — trong container 127.0.0.1 là chính container đó.
#  ⚠️ TUYỆT ĐỐI không commit file .env thật lên git.
# =============================================================================

APP_NAME="Quan Ly Diem Danh Sinh Vien"
APP_ENV=production
# Sinh key riêng: docker compose exec app php artisan key:generate --force
# KHÔNG dùng lại APP_KEY của môi trường khác (lộ key = giải mã được session/cookie).
APP_KEY=
APP_DEBUG=false

# Domain thật, có https. Dùng cho URL trong email, QR điểm danh, callback thanh toán.
APP_DOMAIN=diemdanh.example.com
APP_URL=https://diemdanh.example.com

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Cơ sở dữ liệu (service `mysql` trong docker-compose.yml) ---------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=db_quan_ly_diem_danh
DB_USERNAME=attendia
# ĐỔI: mật khẩu mạnh, sinh bằng `openssl rand -base64 24`
DB_PASSWORD=DOI_MAT_KHAU_NAY
MYSQL_ROOT_PASSWORD=DOI_MAT_KHAU_ROOT_NAY

# --- Redis (service `redis`) -------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Bật mã hoá session trên production
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=redis

FILESYSTEM_DISK=local

# --- Realtime (service `socketio`) -------------------------------------------
SOCKET_PORT=3000
# ĐỂ TRỐNG: Caddy đã proxy /socket.io cùng origin với web. Điền vào sẽ làm
# client gọi sang cổng lạ và bị chặn bởi CORS/HTTPS mixed content.
VITE_SOCKET_URL=
# Giới hạn origin được kết nối websocket (thay '*' bằng domain thật cho an toàn)
SOCKET_CORS_ORIGIN=https://diemdanh.example.com

# --- Email thật (bắt buộc: cảnh báo chuyên cần & kết quả import) -------------
#  Gmail: bật 2FA rồi tạo "App password" 16 ký tự, KHÔNG dùng mật khẩu đăng nhập.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD="app password 16 ky tu"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=your-address@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Chống gian lận GPS — QUAN TRỌNG ----------------------------------------
# Ứng dụng đứng SAU Caddy nên PHẢI khai báo proxy tin cậy, nếu không mọi sinh
# viên sẽ mang cùng một IP (IP của proxy) -> kiểm tra IP/VPN sai hoàn toàn.
#   '*'            : chỉ dùng khi Caddy/Nginx là lớp ngoài cùng (như compose này)
#   danh sách CIDR : dùng khi có Cloudflare đứng trước, liệt kê dải IP Cloudflare
TRUSTED_PROXIES=*
# true = bật chấm nghi vấn theo IP. Để trống cũng tự bật vì đã có TRUSTED_PROXIES.
GPS_IP_CHECK=true

# --- Đăng nhập Google --------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://diemdanh.example.com/auth/google/callback

# --- Thanh toán --------------------------------------------------------------
# MoMo (production: đổi endpoint sang môi trường thật do MoMo cấp)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://payment.momo.vn/v2/gateway/api/create
MOMO_IPN_URL=https://diemdanh.example.com/payment/momo/ipn

# PayOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=https://diemdanh.example.com/payment/payos/return
PAYOS_CANCEL_URL=https://diemdanh.example.com/payment/payos/return?cancel=true

# --- Telegram ----------------------------------------------------------------
# Bot Token nhập trong /admin/{id}/settings, không đặt ở đây.
# Sau khi domain đã trỏ đúng: docker compose exec app php artisan telegram:set-webhook
TELEGRAM_WEBHOOK_URL=https://diemdanh.example.com/telegram/webhook
